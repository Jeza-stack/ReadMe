{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Literature guide frontmatter",
  "type": "object",
  "required": ["title", "slug", "author", "courses", "type", "summary", "updated"],
  "properties": {
    "title": { "type": "string" },
    "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "author": { "type": "string" },
    "courses": { "type": "array", "items": { "enum": ["english-i", "english-ii", "english-iii", "english-iv"] } },
    "units": { "type": "array", "items": { "type": "string" } },
    "type": { "enum": ["poem", "prose", "short-story", "play", "essay", "speech", "interview", "life-writing"] },
    "summary": { "type": "string", "maxLength": 300 },
    "themes": { "type": "array", "items": { "type": "string" } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "related": { "type": "array", "items": { "type": "string" } },
    "updated": { "type": "string", "format": "date" },
    "copyright": {
      "type": "object",
      "description": "Mandatory before the JSON fallback is retired. Status is a JB-reviewed decision, never automated.",
      "properties": {
        "status": { "enum": ["public-domain", "copyrighted"] },
        "note": { "type": "string", "description": "one-line justification, JB-approved" },
        "readAt": { "type": "string", "description": "authorised source link (copyrighted works): publisher → author site → licensed educational source → recognised archive" }
      }
    },
    "sourceType": { "enum": ["original-analysis", "summary", "primary-text", "quotation", "external-resource"] }
  }
}
